# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in. NEVER commit `.env.local`.
# Every value here is available on a free, no-credit-card tier.
# ---------------------------------------------------------------------------

# --- MongoDB Atlas (https://mongodb.com/atlas -> free M0 cluster) -----------
# SERVER ONLY. Holds users, workspaces, documents, chunk text, chat and logs.
# Database -> Connect -> Drivers -> copy the SRV string, then substitute your
# database user's password for <password>.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=groundwork

# --- Qdrant Cloud (https://cloud.qdrant.io -> free 1GB cluster) -------------
# SERVER ONLY. THE single shared vector store: one collection for every
# workspace, separated only by a workspaceId payload filter.
QDRANT_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.eu-central-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=workspace_chunks

# --- Auth -------------------------------------------------------------------
# SERVER ONLY. Signs the session JWT. At least 32 characters.
# Generate one with:  openssl rand -base64 32
# Rotating this invalidates every existing session.
AUTH_SECRET=replace-me-with-at-least-32-random-characters

# --- Google Gemini (https://aistudio.google.com/apikey) ---------------------
# SERVER ONLY. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=your-gemini-api-key

# Model IDs are pinned so an upstream default change can't silently alter
# behaviour.
#
# Pick the chat model carefully on the free tier. Measured limits: every full
# flash model (gemini-3.8-flash, gemini-3.6-flash, and the gemini-flash-latest
# alias) allows only 20 requests PER DAY free, and the pro previews allow 0.
# One chat turn costs several requests, so a full flash model 429s after a few
# questions. The flash-lite models have a usable quota and still support
# function calling plus the streamed SSE protocol this app relies on.
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Must match the vector size the Qdrant collection was created with;
# `uv run python -m scripts.migrate` refuses to continue on a mismatch.
# Changing it requires re-embedding every document into a new collection.
EMBEDDING_DIMENSIONS=1536

# --- Notification webhook (optional) ----------------------------------------
# SERVER ONLY. Accepts a Slack OR a Discord incoming-webhook URL; the transport
# is detected from the hostname. Leave blank and the send_notification tool
# reports itself as unconfigured to the model instead of failing the request.
NOTIFICATION_WEBHOOK_URL=

# --- Rate limiting (optional) -----------------------------------------------
# Chat turns allowed per workspace per minute. Every tenant shares ONE free-tier
# Gemini quota, so this stops a single busy workspace spending everyone else's.
# In-process: with more than one API instance the effective limit multiplies.
CHAT_RATE_LIMIT_PER_MINUTE=12

# --- Deployment -------------------------------------------------------------
# Set to `production` on the API host. Controls the `Secure` flag on the
# session cookie, so leaving it unset in production ships an insecure cookie.
ENVIRONMENT=development

# Where the Next.js client proxies /api/* to. CLIENT-SIDE BUILD ONLY, and not a
# secret — it is the one variable the Vercel deployment needs. Locally the
# default (http://127.0.0.1:8000) is correct, so leave it blank.
BACKEND_URL=

# Origins allowed to call the API directly. Normally EMPTY: the client proxies
# /api/*, so requests are same-origin and no CORS entry is needed. Populate it
# only for a split-origin deployment, which also weakens the session cookie.
CORS_ORIGINS=

# --- Demo seed (optional, local tooling only) -------------------------------
# Credentials `uv run python -m scripts.seed` creates for the reviewer account.
SEED_EMAIL=reviewer@example.com
SEED_PASSWORD=groundwork-demo-2026
